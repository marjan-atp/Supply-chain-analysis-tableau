      <aliases enabled='yes' />
      <column datatype='integer' name='[Availability]' role='measure' type='quantitative' />
      <column caption='Total Revenue' datatype='real' name='[Calculation_0352950701838336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue generated])' />
      </column>
      <column caption='Total products sold' datatype='integer' name='[Calculation_0352950702460929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Number of products sold])' />
      </column>
      <column caption='Average Selling price' datatype='real' name='[Calculation_0352950702628866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue generated])/SUM([Number of products sold])' />
      </column>
      <column caption='Inventory Turnover' datatype='real' name='[Calculation_0352950703173635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Number of products sold])/AVG([Stock levels])' />
      </column>
      <column caption='Stock Availablity Rate' datatype='real' name='[Calculation_0352950709452804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Availability])/SUM([Stock levels])' />
      </column>
      <column caption='Manufacturing Cost Per Product' datatype='real' name='[Calculation_0352950710439941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Manufacturing costs])/SUM([Production volumes])' />
      </column>
      <column caption='Defect Rate%' datatype='real' name='[Calculation_0352950710751238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Defect rates])/100' />
      </column>
      <column caption='Delay Days' datatype='integer' name='[Calculation_1360378647126016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(0,&#13;&#10;[Shipping times]-[Lead time])' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_1360378649366529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Revenue generated])-SUM([Costs])-SUM([Shipping costs])-SUM([Manufacturing costs]))/SUM([Revenue generated])' />
      </column>
